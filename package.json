{
  "name": "dsh-splash",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Brand splash: plays the DeepSeek Harness opening animation before the workspace appears.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "browser/*.js",
    "browser/*.css",
    "browser/*.svg",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
