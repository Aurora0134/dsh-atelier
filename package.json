{
  "name": "dsh-atelier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interface craft for DSH: session motion, the aside session tab, the appearance switch and the brand splash in one bundle.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "browser/*.js",
    "browser/*.css",
    "browser/*.svg",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
